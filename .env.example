# 复制为 .env 并按需修改。生产环境不要把 .env 提交到版本库。

PORT=8080
DATA_DIR=./data

# 必填：32 字节以上随机串，用于加密服务实例密钥、签名会话 Cookie。
# 生成方法：openssl rand -base64 48
APP_SECRET=

# single（默认，单管理员）｜ multi（M2+ 支持）｜ none（关闭认证，仅限可信内网）
AUTH_MODE=single

# 留空则首次访问进入初始化页面手动设置管理员密码
ADMIN_PASSWORD=

# 对外访问地址，用于生成下载链接和 Cookie 设置（可留空）
BASE_URL=

MAX_ACTIVE_JOBS=2
LOG_LEVEL=info
TZ=UTC

# 以下变量在 M1 中尚未实现效果，预留给 M2/M3：
# FILE_RETENTION_DAYS=30
# WATCH_ROOTS=
# HTTPS_PROXY=
# NO_PROXY=
