{
  "name": "@subferry/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@subferry/core": "workspace:*",
    "@subferry/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.4",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^11.8.1",
    "bottleneck": "^2.19.5",
    "chardet": "^2.0.2",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "franc-min": "^6.2.0",
    "iconv-lite": "^0.6.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
